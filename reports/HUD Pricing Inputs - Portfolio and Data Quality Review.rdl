idth></ns0:Textbox><ns0:Textbox Name="Value3"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>=First(Fields!nonunique_property_contract_bedroom_key_groups.Value, "SourceQuality")</ns0:Value><ns0:Style><ns0:FontSize>17pt</ns0:FontSize><ns0:FontWeight>Bold</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>1.54in</ns0:Top><ns0:Left>4.89in</ns0:Left><ns0:Height>0.35in</ns0:Height><ns0:Width>1.5in</ns0:Width></ns0:Textbox><ns0:Textbox Name="Label4"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>Conflicting key groups</ns0:Value><ns0:Style><ns0:FontSize>8pt</ns0:FontSize><ns0:FontWeight>Bold</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>1.25in</ns0:Top><ns0:Left>6.47in</ns0:Left><ns0:Height>0.28in</ns0:Height><ns0:Width>1.5in</ns0:Width></ns0:Textbox><ns0:Textbox Name="Value4"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>=First(Fields!conflicting_key_groups.Value, "SourceQuality")</ns0:Value><ns0:Style><ns0:FontSize>17pt</ns0:FontSize><ns0:FontWeight>Bold</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>1.54in</ns0:Top><ns0:Left>6.47in</ns0:Left><ns0:Height>0.35in</ns0:Height><ns0:Width>1.5in</ns0:Width></ns0:Textbox><ns0:Textbox Name="PortfolioHeading"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>Portfolio coverage by state and property category</ns0:Value><ns0:Style><ns0:FontSize>12pt</ns0:FontSize><ns0:FontWeight>Bold</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>2.02in</ns0:Top><ns0:Left>0.15in</ns0:Left><ns0:Height>0.25in</ns0:Height><ns0:Width>7.8in</ns0:Width></ns0:Textbox><ns0:Tablix Name="PortfolioDetail"><ns0:DataSetName>PortfolioByState</ns0:DataSetName><ns0:TablixBody><ns0:TablixColumns><ns0:TablixColumn><ns0:Width>1.65in</ns0:Width></ns0:TablixColumn><ns0:TablixColumn><ns0:Width>1.75in</ns0:Width></ns0:TablixColumn><ns0:TablixColumn><ns0:Width>1.25in</ns0:Width></ns0:TablixColumn><ns0:TablixColumn><ns0:Width>1.55in</ns0:Width></ns0:TablixColumn><ns0:TablixColumn><ns0:Width>1.55in</ns0:Width></ns0:TablixColumn></ns0:TablixColumns><ns0:TablixRows><ns0:TablixRow><ns0:Height>0.28in</ns0:Height><ns0:TablixCells><ns0:TablixCell><ns0:CellContents><ns0:Textbox Name="PortfolioDetail_0_0"><ns0:CanGrow>true</ns0:CanGrow><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>State</ns0:Value><ns0:Style /></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style /></ns0:Textbox></ns0:CellContents></ns0:TablixCell><ns0:TablixCell><ns0:CellContents><ns0:Textbox Name="PortfolioDetail_0_1"><ns0:CanGrow>true</ns0:CanGrow><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>Property category</ns0:Value><ns0:Style /></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style /></ns0:Textbox></ns0:CellContents></ns0:TablixCell><ns0:TablixCell><ns0:CellContents><ns0:Textbox Name="PortfolioDetail_0_2"><ns0:CanGrow>true</ns0:CanGrow><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>HUD properties</ns0:Value><ns0:Style /></