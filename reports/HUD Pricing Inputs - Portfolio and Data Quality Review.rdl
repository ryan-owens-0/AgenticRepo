<?xml version='1.0' encoding='utf-8'?>
<ns0:Report xmlns:ns0="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:ns1="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><ns0:AutoRefresh>0</ns0:AutoRefresh><ns0:DataSources><ns0:DataSource Name="PortfolioODBC"><ns0:ConnectionProperties><ns0:DataProvider>ODBC</ns0:DataProvider><ns0:ConnectString>Driver={PostgreSQL Unicode};Server=127.0.0.1;Port=5432;Database=portfolio;sslmode=disable;</ns0:ConnectString><ns0:Prompt>Enter the local portfolio database credentials</ns0:Prompt></ns0:ConnectionProperties></ns0:DataSource></ns0:DataSources><ns0:DataSets><ns0:DataSet Name="SourceQuality"><ns0:Query><ns0:DataSourceName>PortfolioODBC</ns0:DataSourceName><ns0:CommandText>SELECT hud_property_rows, hud_rent_observation_rows, unmatched_rent_observation_rows, nonunique_property_contract_bedroom_key_groups, exact_payload_copy_groups, (SELECT COUNT(*) FROM (SELECT property_id, contract_number, assistance_bedroom_count FROM core.hud_rent_observation GROUP BY property_id, contract_number, assistance_bedroom_count HAVING COUNT(*) &gt; 1 AND COUNT(DISTINCT payload_sha256) &gt; 1) AS conflicts) AS conflicting_key_groups FROM mart.vw_hud_source_quality</ns0:CommandText></ns0:Query><ns0:Fields><ns0:Field Name="hud_property_rows"><ns0:DataField>hud_property_rows</ns0:DataField><ns1:TypeName>System.Int64</ns1:TypeName></ns0:Field><ns0:Field Name="hud_rent_observation_rows"><ns0:DataField>hud_rent_observation_rows</ns0:DataField><ns1:TypeName>System.Int64</ns1:TypeName></ns0:Field><ns0:Field Name="unmatched_rent_observation_rows"><ns0:DataField>unmatched_rent_observation_rows</ns0:DataField><ns1:TypeName>System.Int64</ns1:TypeName></ns0:Field><ns0:Field Name="nonunique_property_contract_bedroom_key_groups"><ns0:DataField>nonunique_property_contract_bedroom_key_groups</ns0:DataField><ns1:TypeName>System.Int64</ns1:TypeName></ns0:Field><ns0:Field Name="exact_payload_copy_groups"><ns0:DataField>exact_payload_copy_groups</ns0:DataField><ns1:TypeName>System.Int64</ns1:TypeName></ns0:Field><ns0:Field Name="conflicting_key_groups"><ns0:DataField>conflicting_key_groups</ns0:DataField><ns1:TypeName>System.Int64</ns1:TypeName></ns0:Field></ns0:Fields></ns0:DataSet><ns0:DataSet Name="PortfolioByState"><ns0:Query><ns0:DataSourceName>PortfolioODBC</ns0:DataSourceName><ns0:CommandText>SELECT state_code, state_name, property_category, SUM(hud_property_count) AS hud_property_count, SUM(hud_reported_total_units) AS hud_reported_total_units, SUM(hud_reported_assisted_units) AS hud_reported_assisted_units FROM mart.vw_hud_property_overview GROUP BY state_code, state_name, property_category ORDER BY state_name, property_category</ns0:CommandText></ns0:Query><ns0:Fields><ns0:Field Name="state_code"><ns0:DataField>state_code</ns0:DataField><ns1:TypeName>System.String</ns1:TypeName></ns0:Field><ns0:Field Name="state_name"><ns0:DataField>state_name</ns0:DataField><ns1:TypeName>System.String</ns1:TypeName></ns0:Field><ns0:Field Name="property_category"><ns0:DataField>property_category</ns0:DataField><ns1:TypeName>System.String</ns1:TypeName></ns0:Field><ns0:Field Name="hud_property_count"><ns0:DataField>hud_property_count</ns0:DataField><ns1:TypeName>System.Int64</ns1:TypeName></ns0:Field><ns0:Field Name="hud_reported_total_units"><ns0:DataField>hud_reported_total_units</ns0:DataField><ns1:TypeName>System.Int64</ns1:TypeName></ns0:Field><ns0:Field Name="hud_reported_assisted_units"><ns0:DataField>hud_reported_assisted_units</ns0:DataField><ns1:TypeName>System.Int64</ns1:TypeName></ns0:Field></ns0:Fields></ns0:DataSet></ns0:DataSets><ns0:ReportSections><ns0:ReportSection><ns0:Body><ns0:Height>3.95in</ns0:Height><ns0:ReportItems><ns0:Textbox Name="Title"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>HUD Pricing Inputs | Portfolio &amp; Data Quality Review</ns0:Value><ns0:Style><ns0:FontSize>20pt</ns0:FontSize><ns0:FontWeight>Bold</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>0.08in</ns0:Top><ns0:Left>0.15in</ns0:Left><ns0:Height>0.34in</ns0:Height><ns0:Width>7.8in</ns0:Width></ns0:Textbox><ns0:Textbox Name="Subtitle"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>Public HUD snapshot — source as of 2026-10-06</ns0:Value><ns0:Style><ns0:FontSize>10pt</ns0:FontSize><ns0:FontWeight>Normal</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>0.45in</ns0:Top><ns0:Left>0.15in</ns0:Left><ns0:Height>0.22in</ns0:Height><ns0:Width>7.8in</ns0:Width></ns0:Textbox><ns0:Textbox Name="Limit"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>This report does not show live asking rents, market comps, occupancy, leasing velocity, concessions, or recommended prices. Rent values remain at source-row grain; repeated property/contract/bedroom groups are not aggregated.</ns0:Value><ns0:Style><ns0:FontSize>9pt</ns0:FontSize><ns0:FontWeight>Normal</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>0.7in</ns0:Top><ns0:Left>0.15in</ns0:Left><ns0:Height>0.48in</ns0:Height><ns0:Width>7.8in</ns0:Width></ns0:Textbox><ns0:Textbox Name="Label0"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>HUD property rows</ns0:Value><ns0:Style><ns0:FontSize>8pt</ns0:FontSize><ns0:FontWeight>Bold</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>1.25in</ns0:Top><ns0:Left>0.15in</ns0:Left><ns0:Height>0.28in</ns0:Height><ns0:Width>1.5in</ns0:Width></ns0:Textbox><ns0:Textbox Name="Value0"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>=First(Fields!hud_property_rows.Value, "SourceQuality")</ns0:Value><ns0:Style><ns0:FontSize>17pt</ns0:FontSize><ns0:FontWeight>Bold</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>1.54in</ns0:Top><ns0:Left>0.15in</ns0:Left><ns0:Height>0.35in</ns0:Height><ns0:Width>1.5in</ns0:Width></ns0:Textbox><ns0:Textbox Name="Label1"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>Rent source rows</ns0:Value><ns0:Style><ns0:FontSize>8pt</ns0:FontSize><ns0:FontWeight>Bold</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</ns0:PaddingLeft><ns0:PaddingRight>3pt</ns0:PaddingRight></ns0:Style><ns0:Top>1.25in</ns0:Top><ns0:Left>1.73in</ns0:Left><ns0:Height>0.28in</ns0:Height><ns0:Width>1.5in</ns0:Width></ns0:Textbox><ns0:Textbox Name="Value1"><ns0:CanGrow>true</ns0:CanGrow><ns0:KeepTogether>true</ns0:KeepTogether><ns0:Paragraphs><ns0:Paragraph><ns0:TextRuns><ns0:TextRun><ns0:Value>=First(Fields!hud_rent_observation_rows.Value, "SourceQuality")</ns0:Value><ns0:Style><ns0:FontSize>17pt</ns0:FontSize><ns0:FontWeight>Bold</ns0:FontWeight></ns0:Style></ns0:TextRun></ns0:TextRuns><ns0:Style /></ns0:Paragraph></ns0:Paragraphs><ns0:Style><ns0:PaddingLeft>3pt</n